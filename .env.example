# Haven works fully offline (deterministic "offline brain" + local engines).
# Add any of these keys to switch that sponsor integration to LIVE mode.

# ── Models (Flatkey: one key, 300+ models, automatic failover) ──
FLATKEY_API_KEY=            # sk-fk-...  https://console.flatkey.ai
FLATKEY_BASE_URL=https://router.flatkey.ai/v1
FLATKEY_MODEL_FAST=gpt-4o-mini
FLATKEY_MODEL_REASONING=claude-sonnet-4-5
FLATKEY_MODEL_CODING=claude-sonnet-4-5
FLATKEY_MODEL_VISION=gemini-2.5-flash
# Optional direct fallbacks if Flatkey is unavailable
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HAVEN_LOCAL_CLAUDE=0        # 1 = use the local `claude -p` CLI as a last-resort model

# ── BAND (agent-to-agent comms) ── registers all 8 employees on band.ai + opens a "Haven HQ" room
BAND_USER_KEY=              # band_u_...  https://app.band.ai/users/settings

# ── Masky.AI (faces + voices) ──
MASKY_API_KEY=              # mky_...  https://masky.ai/developer

# ── RocketRide (pipelines/*.pipe) ──
ROCKETRIDE_APIKEY=          # rr_...  https://cloud.rocketride.ai
ROCKETRIDE_URI=https://api.rocketride.ai

# ── n8n (n8n/*.json workflows) ── e.g. http://localhost:5678 after `npx n8n` + import
N8N_URL=
SLACK_WEBHOOK_URL=          # optional: moderator alerts land in Slack

# ── PromptQL (shared data + wiki) ──
PROMPTQL_MCP_URL=           # https://<data-plane>/mcp-server/mcp?project-name=<project>
PROMPTQL_BOT_TOKEN=         # pat_...

# ── Paritok (context compression) ──
PARITOK_API_KEY=            # pk_live_...

# ── Celesto (sandbox computers for link detonation) ──
CELESTO_API_KEY=

# ── Tenki (sandboxed test runs for bot audits) ──
TENKI_API_KEY=              # tk_...

# ── Snyk (dependency + code scanning) ── the CLI also works after `snyk auth`
SNYK_TOKEN=

# ── Kylon (workforce sync via CLI) ──
KYLON_WORKSPACE_ID=

# ── Finch (skills registry) ──
FINCH_API_KEY=
FINCH_BASE_URL=

PORT=8787
HAVEN_SIM_AUTOSTART=1
