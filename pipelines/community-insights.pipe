      "name": "Flatkey model gateway (fast tier)",
      "config": {
        "profile": "custom",
        "custom": {
          "model": "gemini-3.1-flash-lite",
          "base_url": "https://router.flatkey.ai/v1",
          "modelTotalTokens": 32768,
          "apikey": "${ROCKETRIDE_FLATKEY_KEY}"
