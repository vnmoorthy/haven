    {
      "id": "prompt_1",
      "provider": "prompt",
      "name": "Insight writer prompt",
      "config": {
        "parameters": {
          "instructions": "Write 3-5 crisp weekly safety insights for the founders. Return JSON {headline, insights[]}."
        }
      },
      "input": [
        {
          "lane": "text",
          "from": "anomaly_detector_1"
